# Firebase Web SDK config used by Expo at runtime.
EXPO_PUBLIC_APP_ENV=development
# Required for staging/production builds. These IDs must be different; the
# runtime refuses to initialize Firebase when the selected environment does
# not match its explicitly declared project.
EXPO_PUBLIC_STAGING_FIREBASE_PROJECT_ID=your-staging-project-id
EXPO_PUBLIC_PRODUCTION_FIREBASE_PROJECT_ID=your-production-project-id
# Local visual/functional QA only. The app refuses emulator mode unless the
# configured project ID begins with `demo-`.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_DISABLE_ANONYMOUS_AUTH=false
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Enable only in a development/staging project after deploying the third-pass
# Firestore rules and indexes. Both remain false by default.
EXPO_PUBLIC_ENABLE_ALERT_PERSISTENCE=false
EXPO_PUBLIC_ENABLE_HOLD_WORKFLOW=false
EXPO_PUBLIC_ENABLE_DELAY_PERSISTENCE=false
EXPO_PUBLIC_ENABLE_HANDOFF_NOTES=false
EXPO_PUBLIC_ENABLE_SECURE_TRANSITIONS=false
EXPO_PUBLIC_ENABLE_TRAINING_TOOLS=false

# Optional fallback keys for local Node scripts.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Optional Firebase Admin auth for local maintenance scripts.
# Prefer GOOGLE_APPLICATION_CREDENTIALS pointing at a local, ignored JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-service-account.json
